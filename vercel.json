{
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/keep-alive-reminder", "schedule": "0 6 * * *" },
    { "path": "/api/keep-alive-watchdog", "schedule": "49 5 * * *" }
  ]
}
